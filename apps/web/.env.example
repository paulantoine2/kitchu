# ─────────────────────────────────────────────────────────────────────────────
# Environnement local (développement)
# ─────────────────────────────────────────────────────────────────────────────
#
# 1. Démarrer la base locale Prisma Postgres :
#      pnpm db:local
# 2. Écrire les URLs dans .env.local :
#      pnpm db:local:env
# 3. Appliquer les migrations et le seed :
#      pnpm db:local:setup
#
# Ou tout en une commande (si la base n'est pas déjà démarrée) :
#      pnpm db:local:setup
#
# URL TCP directe (utilisée par l'app via @prisma/adapter-pg et par les migrations)
DATABASE_URL=postgres://postgres:postgres@localhost:51214/template1?sslmode=disable
PRISMA_DATABASE_URL=postgres://postgres:postgres@localhost:51214/template1?sslmode=disable
# Taille du pool pg côté adapter (défaut : 10 en dev, 1 en production / serverless)
# DATABASE_POOL_MAX=1

# Authentification Better Auth. Générer le secret avec : openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Le compte OAuth présentant cet email vérifié devient administrateur et
# récupère le panier et les stocks historiques lors de sa première connexion.
KITCHU_ADMIN_EMAIL=admin@example.com

# Google OAuth — callback local : http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple — nécessite une URL HTTPS, même en développement.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Conserver les retours à la ligne sous la forme \n dans la variable Vercel.
APPLE_PRIVATE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Environnement production (Vercel + Prisma Postgres)
# ─────────────────────────────────────────────────────────────────────────────
#
# Configurer dans le dashboard Vercel → Settings → Environment Variables
# (scope : Production, et Preview si souhaité) :
#
#   DATABASE_URL          — fournie par l'intégration Vercel Storage (host db.prisma.io)
#   PRISMA_DATABASE_URL   — souvent identique, utilisée par `prisma migrate deploy`
#   DIRECT_URL            — optionnel, alias direct pour les migrations
#
# L'intégration Vercel Storage provisionne DATABASE_URL pour Prisma Postgres.
#
# Logs de performance (Vercel → Runtime Logs, filtrer sur "[kitchu:perf]") :
#   KITCHU_PERF_LOG=1        — activer en production (actif par défaut en dev)
#   KITCHU_PERF_SLOW_MS=300  — seuil d'alerte pour les étapes lentes (ms)
#
# Les migrations sont appliquées automatiquement à chaque déploiement via :
#   pnpm build  →  prisma generate && prisma migrate deploy && next build
#
# Pour récupérer les variables prod localement (référence uniquement) :
#      pnpm env:pull
#   → écrit dans .env.production.local (ne remplace pas .env.local)
