generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UnitKind {
  MASS
  VOLUME
  COUNT
  PACKAGE
  CUSTOM
}

enum ProductStorageType {
  FRESH
  FROZEN
  DRY
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id                     String             @id
  name                   String
  email                  String             @unique
  emailVerified          Boolean            @default(false)
  image                  String?
  role                   UserRole           @default(USER)
  legacyDataClaimedAt    DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  sessions               Session[]
  accounts               Account[]
  cartItems              CartItem[]
  ownedProductReferences ProductReference[] @relation("ProductReferenceOwner")
  productStates          UserProductState[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
}

model Unit {
  id                 String             @id @default(uuid())
  code               String             @unique
  name               String
  symbol             String
  kind               UnitKind           @default(CUSTOM)
  globalToBaseFactor Float?
  globalBaseUnitId   String?
  globalBaseUnit     Unit?              @relation("UnitGlobalBase", fields: [globalBaseUnitId], references: [id], onDelete: SetNull)
  derivedGlobalUnits Unit[]             @relation("UnitGlobalBase")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  baseIngredients    Ingredient[]       @relation("IngredientBaseUnit")
  ingredientUnits    IngredientUnit[]
  productReferences  ProductReference[]
  recipeIngredients  RecipeIngredient[]
  globalRatiosFrom   UnitRatio[]        @relation("UnitRatioFrom")
  globalRatiosTo     UnitRatio[]        @relation("UnitRatioTo")
}

model UnitRatio {
  id         String   @id @default(uuid())
  fromUnitId String
  toUnitId   String
  factor     Float
  fromUnit   Unit     @relation("UnitRatioFrom", fields: [fromUnitId], references: [id], onDelete: Cascade)
  toUnit     Unit     @relation("UnitRatioTo", fields: [toUnitId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([fromUnitId, toUnitId])
}

model Ingredient {
  id                     String             @id @default(uuid())
  name                   String             @unique
  imageUrl               String?
  notes                  String?
  preparationWeightRatio Float?
  caloriesPer100g        Float?
  proteinPer100g         Float?
  carbsPer100g           Float?
  fatPer100g             Float?
  baseUnitId             String
  baseUnit               Unit               @relation("IngredientBaseUnit", fields: [baseUnitId], references: [id])
  units                  IngredientUnit[]
  products               ProductReference[]
  recipeItems            RecipeIngredient[]
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
}

model IngredientUnit {
  id           String     @id @default(uuid())
  ingredientId String
  unitId       String
  toBaseFactor Float?
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  unit         Unit       @relation(fields: [unitId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([ingredientId, unitId])
}

model ProductReference {
  id                  String             @id @default(uuid())
  ingredientId        String
  store               String
  brand               String?
  name                String
  imageUrl            String?
  storageType         ProductStorageType @default(FRESH)
  ownerId             String?
  packageQuantity     Float
  packageUnitId       String
  packageToBaseFactor Float?
  price               Float
  url                 String?
  barcode             String?
  notes               String?
  caloriesPer100g     Float?
  proteinPer100g      Float?
  carbsPer100g        Float?
  fatPer100g          Float?
  ingredient          Ingredient         @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  packageUnit         Unit               @relation(fields: [packageUnitId], references: [id])
  owner               User?              @relation("ProductReferenceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  userStates          UserProductState[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([ingredientId, ownerId])
}

model UserProductState {
  id                 String           @id @default(uuid())
  userId             String
  productReferenceId String
  stockQuantity      Float?
  priceOverride      Float?
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  productReference   ProductReference @relation(fields: [productReferenceId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([userId, productReferenceId])
  @@index([productReferenceId])
}

model Recipe {
  id          String             @id @default(uuid())
  name        String
  imageUrl    String?
  description String?
  sourceUrl   String?
  prepMinutes Int?
  cookMinutes Int?
  ingredients RecipeIngredient[]
  steps       RecipeStep[]
  cartItems   CartItem[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model CartItem {
  id        String   @id @default(uuid())
  userId    String
  recipeId  String
  portions  Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, recipeId])
  @@index([recipeId])
}

model LegacyCartItem {
  recipeId String @id
  portions Int

  @@map("LegacyCartItem")
}

model LegacyProductStock {
  productReferenceId String @id
  stockQuantity      Float

  @@map("LegacyProductStock")
}

model RecipeIngredient {
  id                     String     @id @default(uuid())
  recipeId               String
  ingredientId           String
  unitId                 String
  quantityPerServing     Float
  unitToBaseFactor       Float?
  preparationWeightRatio Float?
  note                   String?
  position               Int
  recipe                 Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient             Ingredient @relation(fields: [ingredientId], references: [id])
  unit                   Unit       @relation(fields: [unitId], references: [id])
}

model RecipeStep {
  id          String @id @default(uuid())
  recipeId    String
  position    Int
  instruction String
  recipe      Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}
