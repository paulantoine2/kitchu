{
  "name": "@kitchu/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "dev": "expo start --dev-client",
    "start": "expo start --dev-client",
    "start:go": "expo start --go",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:clean": "expo run:ios --no-build-cache",
    "pods:ios": "cd ios && pod install",
    "eas:init": "pnpm dlx eas-cli@latest init",
    "build:development": "pnpm dlx eas-cli@latest build --profile development --platform all",
    "build:simulator": "pnpm dlx eas-cli@latest build --profile development-simulator --platform ios",
    "build:preview": "pnpm dlx eas-cli@latest build --profile preview --platform all",
    "build:ios": "pnpm dlx eas-cli@latest build --profile production --platform ios",
    "build:android": "pnpm dlx eas-cli@latest build --profile production --platform android",
    "build:production": "pnpm dlx eas-cli@latest build --profile production --platform all",
    "submit:production": "pnpm dlx eas-cli@latest submit --profile production --platform all --latest",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test 'lib/**/*.test.ts'"
  },
  "dependencies": {
    "@better-auth/expo": "^1.6.29",
    "@expo/vector-icons": "^15.0.3",
    "@kitchu/domain": "workspace:*",
    "@tanstack/query-async-storage-persister": "^5.90.2",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-query-persist-client": "^5.90.2",
    "better-auth": "1.6.29",
    "expo": "~57.0.13",
    "expo-constants": "~57.0.11",
    "expo-dev-client": "~57.0.12",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-linking": "~57.0.6",
    "expo-network": "~57.0.1",
    "expo-router": "~57.0.13",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "19.2.18",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.1",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3"
  },
  "private": true
}
